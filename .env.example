# ============================================================
# DRISHTI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_DB=drishti
POSTGRES_USER=drishti
POSTGRES_PASSWORD=change_me_in_production

# ----- Backend -----
DATABASE_URL=postgresql://drishti:change_me_in_production@db:5432/drishti
BACKEND_PORT=8000
APP_ENV=development
APP_DEBUG=true

# ----- Frontend -----
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api
# Optional official complaint portal. Leave blank to keep external handoff disabled.
VITE_EXTERNAL_COMPLAINT_PORTAL_URL=

# ----- Authentication (Phase 7C) -----
JWT_SECRET_KEY=change_me_in_production_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_BOOTSTRAP_USERNAME=admin_example
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_password
ADMIN_BOOTSTRAP_EMAIL=admin@drishti.local

# ----- OCR (Phase 1 — not yet active) -----
# PADDLEOCR_LANG=en
# PADDLEOCR_USE_GPU=false

# ----- Optional Gemini package understanding (Stage 1) -----
# Disabled by default. PaddleOCR and manual clarification remain available.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=12
GEMINI_CONTEXT_MIN_CONFIDENCE=0.75

# ----- Upload Limits (Phase 1 — not yet active) -----
# MAX_UPLOAD_SIZE_MB=20
# ALLOWED_MIME_TYPES=image/jpeg,image/png

# ----- Object Storage (MinIO / S3) -----
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=drishti_minio
MINIO_ROOT_PASSWORD=change_me_minio_root_password
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET_NAME=drishti-captures
MINIO_SECURE=false
